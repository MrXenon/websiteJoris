# =========================================================
# Instellingen voor Apache-hosting
# (Herd/nginx lokaal heeft dit niet nodig: daar gaat elke onbekende URL al naar index.php)
# =========================================================

Options -Indexes -MultiViews

# ---------- Nette URL's zonder .php ----------
# Alles wat geen bestaand bestand of map is, gaat naar index.php (de router).
# Die zoekt de juiste pagina en stuurt oude links (bijv. kamados.php) door naar de nette URL.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Staat de site in een submap (bijv. /kamado/)? Zet dan hieronder: RewriteBase /kamado/
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# ---------- Compressie (kleinere bestanden = snellere site) ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- Browsercache ----------
# CSS en JS krijgen een versienummer (?v=...) in de URL, dus die mogen lang bewaard worden.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/jpeg               "access plus 6 months"
    ExpiresByType image/png                "access plus 6 months"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp

# ---------- Afschermen ----------
# Deze bestanden zijn alleen voor de ontwikkelaar
<FilesMatch "\.(md|log|lock)$|^\.git">
    Require all denied
</FilesMatch>
